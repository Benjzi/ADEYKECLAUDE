# Copy this file to .env and fill in your Supabase project's values.
# Never commit the real .env file — it's already in .gitignore.

VITE_SUPABASE_URL="https://hjcglwesrybxbztaukoc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="hjcglwesrybxbztaukoc"

# Optional. Image resizing needs Supabase image transformations (paid plan).
# "off" = never request resized images (use originals); "on" = always try;
# unset = automatic (try, and remember if it doesn't work).
# VITE_IMAGE_TRANSFORMS="off"

# Optional. "off" = never use public image URLs (use signed URLs); "on" =
# always use public URLs; unset = automatic (public, falling back to signed).
# VITE_MEDIA_PUBLIC="off"
